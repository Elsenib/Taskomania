# Claude Code's local session/tooling data (bundled skill library, plans,
# etc.) — not project source, not meant to be shared in the app's repo.
.claude/

# Raw source exports kept on disk for reference — the actually-used copies
# live under packages/desktop/src/renderer/assets/.
/taskomania.png
/Taskomania_startup_animation_video_*.mp4

# electron-builder reads its icon/installer-bitmap inputs from this
# conventionally-named "build/" folder — these are source assets, not
# build output, so they're tracked despite the blanket rule above.
!packages/desktop/build/
!packages/desktop/build/**
