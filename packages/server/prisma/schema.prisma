generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AttachmentKind {
  FILE
  ARCHIVE
}

model Team {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  users     User[]
  invites   Invite[]
  columns   Column[]
  tasks     Task[]
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  displayName    String
  role           Role      @default(MEMBER)
  createdAt      DateTime  @default(now())
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id])
  createdInvites Invite[]  @relation("InviteCreatedBy")
  assignedTasks  Task[]    @relation("TaskAssignee")
  createdTasks   Task[]    @relation("TaskCreatedBy")
  comments       Comment[]
  attachments    Attachment[]

  @@index([teamId])
}

model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User    @relation("InviteCreatedBy", fields: [createdById], references: [id])

  @@index([teamId])
}

model Column {
  id     String @id @default(uuid())
  name   String
  order  Int
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  tasks  Task[]

  @@index([teamId])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  order       Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  columnId String
  column   Column @relation(fields: [columnId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  comments    Comment[]
  attachments Attachment[]
  blockingOf  TaskDependency[] @relation("BlockingTask")
  blockedBy   TaskDependency[] @relation("BlockedTask")

  @@index([teamId, columnId])
  @@index([assigneeId])
}

model TaskDependency {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blockingTaskId String
  blockingTask   Task   @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  blockedTaskId String
  blockedTask   Task   @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
  @@index([blockingTaskId])
  @@index([blockedTaskId])
}

model Comment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model Attachment {
  id           String         @id @default(uuid())
  kind         AttachmentKind
  originalName String
  accessToken  String         @unique
  sizeBytes    Int
  createdAt    DateTime       @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
}
